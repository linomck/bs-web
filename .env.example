# Domain, unter der dein bestehender Traefik ein Let's-Encrypt-Zertifikat für
# diesen Container ausstellen soll. Muss per DNS (A/AAAA-Record) auf die IP
# dieses Servers zeigen.
DOMAIN=stream.n2nd.de

# Name des externen Docker-Netzwerks, an das dein bereits laufender Traefik
# angebunden ist (z.B. "proxy", "traefik", "web" - `docker network ls` prüfen).
TRAEFIK_NETWORK=proxy

# Name des Entrypoints (in deiner Traefik-Konfiguration), über den HTTPS läuft.
TRAEFIK_ENTRYPOINT=websecure

# Name des certResolver in deiner Traefik-Konfiguration (Let's Encrypt).
TRAEFIK_CERTRESOLVER=le

# CapSolver API-Key für die reCAPTCHA-v2-Lösung (erforderlich für /api/resolve)
CAPSOLVER_API_KEY=

# Optional: Basis-Domains von Burning Series
BS_BASE_URL=https://burningseries.cx
BS_FALLBACK_URL=https://bs.to

# Pocket ID (OIDC) via traefik-oidc-auth Plugin
OIDC_PROVIDER_URL=https://id.n2nd.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Zufälliger String (mind. 32 Zeichen), z.B. `openssl rand -hex 32`
OIDC_COOKIE_SECRET=
