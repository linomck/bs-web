{
  "manifest_version": 3,
  "name": "N2nd",
  "version": "1.1.0",
  "description": "Löst Burning-Series-Streams lokal auf (eigene IP) und liefert die direkte M3U8 an N2nd (Nightsecond).",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://burningseries.cx/*",
    "https://bs.to/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://stream.n2nd.de/*",
      "http://localhost/*"
    ]
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}